<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">your-ip-or-domain</domain>
    <trust-anchors>
      <certificates src="user" /> <!-- Trust user-added CAs -->
    </trust-anchors>
  </domain-config>
</network-security-config>